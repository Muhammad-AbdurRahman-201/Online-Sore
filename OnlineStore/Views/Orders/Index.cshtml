@model List<OnlineStore.Models.Order>

<h2>My Orders</h2>

@if (Model.Count == 0)
{
    <p>Abhi koi order nahi hai.</p>
}
else
{
    foreach (var order in Model)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Order #@order.Id</h5>
                <div>
                    <span class="text-muted me-2">@order.OrderDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                    <span class="badge bg-warning text-dark">@order.Status</span>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead>
                        <tr><th>Product</th><th>Price</th><th>Qty</th><th>Total</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.Items)
                        {
                            <tr>
                                <td>@item.Product.Title</td>
                                <td>Rs. @item.UnitPrice.ToString("N0")</td>
                                <td>@item.Quantity</td>
                                <td>Rs. @((item.UnitPrice * item.Quantity).ToString("N0"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <h5>Total: Rs. @order.TotalAmount.ToString("N0")</h5>
            </div>
        </div>
    }
}