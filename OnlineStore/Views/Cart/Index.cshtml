@model List<OnlineStore.Models.Cart>

<h2>Your Cart</h2>

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <h4>Aapka cart khali hai</h4>
        <p class="text-muted">Kuch products add karein aur shopping shuru karein.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Products dekhein</a>
    </div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Product.Title</td>
                    <td>Rs. @item.Product.Price.ToString("N0")</td>

                    <td>
                        <!-- Minus -->
                        <form asp-controller="Cart" asp-action="Update" method="post" class="d-inline">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                            <button class="btn btn-sm btn-outline-secondary">-</button>
                        </form>

                        <span class="mx-2">@item.Quantity</span>

                        <!-- Plus -->
                        <form asp-controller="Cart" asp-action="Update" method="post" class="d-inline">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                            <button class="btn btn-sm btn-outline-secondary">+</button>
                        </form>
                    </td>

                    <td>Rs. @((item.Product.Price * item.Quantity).ToString("N0"))</td>

                    <td>
                        <!-- Remove -->
                        <form asp-controller="Cart" asp-action="Remove" method="post">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button class="btn btn-sm btn-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h4>Grand Total: Rs. @Model.Sum(i => i.Product.Price * i.Quantity).ToString("N0")</h4>

    <form asp-controller="Orders" asp-action="Checkout" method="post">
        <button type="submit" class="btn btn-primary btn-lg">Checkout</button>
    </form>
}